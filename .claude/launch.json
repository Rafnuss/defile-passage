{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "defile-website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../defile-website",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "viewer",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "output/site"
      ],
      "port": 8765
    },
    {
      "name": "methods",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "site",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "http.server",
        "8766",
        "--directory",
        "logs/preview"
      ],
      "port": 8766
    }
  ]
}
