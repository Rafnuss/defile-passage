{
  "name": "defile-passage-docs",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:data",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
